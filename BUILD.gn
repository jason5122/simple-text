group("all") {
  deps = [
    "//benchmark",
    "//conformance",
    "//simple_text",
  ]
}

group("tests") {
  testonly = true
  deps = [
    "//testing:perf_tests",
    "//testing:unit_tests",
  ]
}

group("experiments") {
  deps = [
    "//experiments/canary",
    "//experiments/examples",
    "//experiments/fuzz",
    "//experiments/playground",
    "//experiments/rope",
  ]

  if (is_mac) {
    deps += [ "//experiments/mac_startup_benchmark" ]
  }
}
