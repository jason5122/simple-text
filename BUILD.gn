group("all") {
  deps = [
    "//conformance",
    "//simple_text",

    # TODO: Think about how we should structure perf tests. Loose executables
    # are probably fine, but we need to organize them somehow.
    "//base:unicode_perftest",
    "//fx:fx_glyph_cache_perftest",
    "//fx:fx_perftest",
  ]

  if (is_mac) {
    deps += [ "//benchmark" ]
  }
}

group("tests") {
  testonly = true
  deps = [
    "//testing:perf_tests",
    "//testing:unit_tests",
  ]
}

group("experiments") {
  deps = [
    "//experiments/btree:bptree_example",
    "//experiments/btree:bptree_perftest",
    "//experiments/btree:btree_example",
    "//experiments/btree:sum_tree_example",
    "//experiments/canary",
    "//experiments/examples",
    "//experiments/function:function_example",
    "//experiments/fuzz",
    "//experiments/playground",
  ]
}
