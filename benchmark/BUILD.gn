assert(is_mac, "//benchmark is macOS-only")

group("benchmark") {
  deps = [
    ":drive_scroll",
    ":glass_capture",
    ":scroll_benchmark",
    ":scrollbar_benchmark",
    ":startup_benchmark",
  ]
}

# Posts a recorded scroll at the HID tap into any application's window, for
# comparisons under Instruments (benchmark/README.md, "Measuring other apps").
executable("drive_scroll") {
  sources = [ "drive_scroll.mm" ]
  frameworks = [
    "AppKit.framework",
    "ApplicationServices.framework",
  ]
}

# Captures what the display shows of any application's window at the refresh
# rate (benchmark/README.md, "Measuring other apps").
executable("glass_capture") {
  sources = [ "glass_capture.mm" ]
  frameworks = [
    "AppKit.framework",
    "CoreMedia.framework",
    "CoreVideo.framework",
    "Foundation.framework",
    "ScreenCaptureKit.framework",
  ]
}

executable("scroll_benchmark") {
  sources = [ "scroll_benchmark.cc" ]
  deps = [
    "//px",
    "//ui",
  ]
}

executable("scrollbar_benchmark") {
  sources = [ "scrollbar_benchmark.cc" ]
  deps = [
    "//px",
    "//ui",
  ]
}

executable("startup_benchmark") {
  sources = [ "startup_benchmark.cc" ]
  deps = [ "//ui" ]
}
