config("runtime_library") {
  # Don't leak any symbols on a static build.
  defines = [ "_LIBCPP_DISABLE_VISIBILITY_ANNOTATIONS" ]
  if (is_posix) {
    defines += [ "_LIBCXXABI_DISABLE_VISIBILITY_ANNOTATIONS" ]
  }

  # libc++ expects `__assertion_handler` and `__config_site`.
  include_dirs = [ "//build/third_party/libc++" ]

  if (is_win) {
    # We don't use libc++abi on Windows because libc++abi only implements the Itanium C++ ABI and
    # not the Microsoft ABI.
    cflags_cc =
        [ "-I" + rebase_path("//third_party/libc++/include", root_build_dir) ]
  } else {
    cflags_cc = [
      "-nostdinc++",
      "-isystem" + rebase_path("//third_party/libc++/include", root_build_dir),
      "-isystem" +
          rebase_path("//third_party/libc++abi/include", root_build_dir),
    ]
    cflags_objcc = cflags_cc

    ldflags = [ "-nostdlib++" ]
  }
}
