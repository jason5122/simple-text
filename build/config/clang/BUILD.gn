import("//build/config/clang/clang.gni")

config("compiler_builtins") {
  if (is_mac) {
    _dir = "darwin"
    _lib_file = "libclang_rt.osx.a"
  } else if (is_win) {
    if (current_cpu == "x64") {
      _suffix = "-x86_64"
    } else if (current_cpu == "arm64") {
      _suffix = "-aarch64"
    } else {
      assert(false, "unhandled cpu")
    }
    _dir = "windows"
    _lib_file = "clang_rt.builtins${_suffix}.lib"
  } else if (is_linux) {
    if (current_cpu == "x64") {
      _dir = "x86_64-unknown-linux-gnu"
    } else if (current_cpu == "arm64") {
      _dir = "aarch64-unknown-linux-gnu"
    } else {
      assert(false, "unhandled cpu")
    }
    _lib_file = "libclang_rt.builtins.a"
  } else {
    assert(false, "unhandled platform")
  }

  _clang_lib_dir = "$clang_base_path/lib/clang/$clang_version/lib"
  libs = [ "$_clang_lib_dir/$_dir/$_lib_file" ]
}

# https://clang.llvm.org/docs/SafeBuffers.html
config("unsafe_buffers") {
  _unsafe_buffers_paths = "//build/config/unsafe_buffers_paths.txt"

  inputs = [ _unsafe_buffers_paths ]
  cflags = [
    # If -Werror is set, the plugin still suppresses the warning from printing, but clang still
    # exits with a nonzero status because an error occurred.
    # To prevent this, we use -Wno-error. If -Werror is set, the plugin upgrades this to an error
    # manually, thus ignoring the -Wno-error.
    "-Wunsafe-buffer-usage",
    "-Wno-error=unsafe-buffer-usage",

    "-Xclang",
    "-add-plugin",
    "-Xclang",
    "unsafe-buffers",

    "-Xclang",
    "-plugin-arg-unsafe-buffers",
    "-Xclang",
    rebase_path(_unsafe_buffers_paths, root_build_dir),
  ]
}
