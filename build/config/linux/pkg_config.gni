import("//build/config/sysroot.gni")

template("pkg_config") {
  assert(defined(invoker.packages),
         "Variable |packages| must be defined to be a list in pkg_config.")
  config(target_name) {
    pkg_config_script = "//build/config/linux/pkg-config.py"
    pkg_config_args = [
      "-s",
      rebase_path(sysroot),
      "-a",
      current_cpu,
    ]

    args = pkg_config_args + invoker.packages
    pkgresult = exec_script(pkg_config_script, args, "json")

    cflags = pkgresult[1]
    cflags_c = []
    cflags_cc = []

    foreach(_path, pkgresult[0]) {
      # We want the system include paths to use -isystem instead of -I to suppress warnings in those
      # headers. Append to both cflags_c/cflags_cc instead of cflags, so cflags take priority over
      # them in the include paths.
      cflags_c += [ "-isystem$_path" ]
      cflags_cc += [ "-isystem$_path" ]
    }

    if (!defined(invoker.ignore_libs) || !invoker.ignore_libs) {
      libs = pkgresult[2]
      lib_dirs = pkgresult[3]
    }

    forward_variables_from(invoker,
                           [
                             "defines",
                             "visibility",
                           ])
  }
}
