declare_args() {
  # This variable corresponds to the `MACOSX_DEPLOYMENT_TARGET` define. Changing this controls which
  # symbols the macOS SDK marks as available (via `__builtin_available` and `@available`) and
  # deprecated (producing a warning if called).
  #
  # This also controls the value of the `LSMinimumSystemVersion` in `Info.plist` files. This value
  # controls the minimum OS version that may launch the application, and OS releases older than this
  # will refuse to launch the application.
  mac_deployment_target = "11.0"

  # Minimum supported version of the Mac SDK.
  mac_sdk_min = "14"

  # Override for where the macOS SDK comes from: a `.sdk`, a directory containing one, or Xcode.app.
  # Empty auto-discovers.
  mac_sdk_path = ""
}

_find_sdk = "//build/config/mac/find_sdk.py"

if (mac_sdk_path != "") {
  mac_sdk_path = exec_script(_find_sdk,
                             [
                               "--sysroot",
                               rebase_path(mac_sdk_path),
                             ],
                             "trim string")
} else if (host_os == "mac") {
  mac_sdk_path = exec_script(_find_sdk, [ mac_sdk_min ], "trim string")
} else {
  # Cross-compiling to macOS: xcrun isn't available, so use the SDK staged in the conventional
  # sysroot dir (find_sdk.py errors clearly if it isn't there).
  mac_sdk_path = exec_script(_find_sdk,
                             [
                               "--sysroot",
                               rebase_path("//third_party/mac-sysroot"),
                             ],
                             "trim string")
}
