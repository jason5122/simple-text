import("//build/config/clang/clang.gni")
import("//build/config/sanitizers/sanitizers.gni")

config("default_sanitizer_flags") {
  configs = [
    ":asan_flags",
    ":ubsan_flags",
    ":fuzztest_coverage",
  ]
}

config("asan_flags") {
  if (is_asan) {
    cflags = [ "-fsanitize=address" ]

    if (is_posix) {
      ldflags = [ "-fsanitize=address" ]
    } else if (is_win) {
      # TODO: Copy these to the build dir.
      assert(current_cpu == "x64", "WinASan is x64-only")
      _clang_lib_dir = "$clang_base_path/lib/clang/$clang_version/lib/windows"
      libs = [ "$_clang_lib_dir/clang_rt.asan_dynamic-x86_64.lib" ]
      ldflags =
          [ "-wholearchive:clang_rt.asan_static_runtime_thunk-x86_64.lib" ]
      libs +=
          [ "$_clang_lib_dir/clang_rt.asan_static_runtime_thunk-x86_64.lib" ]
    }
  }
}

config("ubsan_flags") {
  if (is_ubsan) {
    cflags = [ "-fsanitize=undefined" ]

    if (is_posix) {
      ldflags = [ "-fsanitize=undefined" ]
    }
  }
}

config("fuzztest_coverage") {
  if (enable_fuzztest_fuzz) {
    cflags = [ "-fsanitize-coverage=inline-8bit-counters" ]
  }
}
