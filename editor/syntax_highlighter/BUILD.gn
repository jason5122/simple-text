source_set("syntax_highlighter") {
  sources = [
    "highlighter.cc",
    "highlighter.h",
    "language.cc",
    "language.h",
    "parse_tree.cc",
    "parse_tree.h",
    "types.h",
  ]

  deps = [
    ":languages",
    "//third_party/tree_sitter",
  ]
}

if (is_mac) {
  bundle_data("languages") {
    sources = [
      "languages/cpp",
      "languages/json",
    ]
    outputs = [ "{{bundle_resources_dir}}/languages/{{source_file_part}}" ]
  }
} else {
  copy("languages") {
    sources = [
      "languages/cpp",
      "languages/json",
    ]
    outputs = [ "$root_out_dir/languages/{{source_file_part}}" ]
  }
}
