executable("btree") {
  sources = [ "main.cc" ]

  deps = [ ":btree_lib" ]
}

source_set("btree_lib") {
  sources = [
    "btree.cc",
    "btree.h",
  ]
}

source_set("bptree_lib") {
  sources = [
    "bptree.cc",
    "bptree.h",
  ]
}

executable("bptree_perftest") {
  sources = [ "bptree_perftest.cc" ]

  deps = [ ":bptree_lib" ]
}

source_set("btree_unittest") {
  testonly = true

  sources = [ "btree_unittest.cc" ]

  deps = [
    ":btree_lib",
    "//testing:fuzztest",
  ]
}

source_set("bptree_unittest") {
  testonly = true

  sources = [ "bptree_unittest.cc" ]

  deps = [
    ":bptree_lib",
    "//testing:fuzztest",
  ]
}
