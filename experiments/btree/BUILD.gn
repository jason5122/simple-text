executable("btree_example") {
  sources = [ "btree_example.cc" ]

  deps = [ ":btree_lib" ]
}

executable("bptree_example") {
  sources = [ "bptree_example.cc" ]

  deps = [ ":bptree_lib" ]
}

executable("sum_tree_example") {
  sources = [ "sum_tree_example.cc" ]

  deps = [ ":sum_tree_lib" ]
}

source_set("btree_lib") {
  sources = [
    "btree.cc",
    "btree.h",
  ]
}

source_set("bptree_lib") {
  sources = [
    "bptree.cc",
    "bptree.h",
  ]
}

source_set("sum_tree_lib") {
  sources = [
    "sum_tree.h",
    "sum_tree_svg.h",
  ]
}

source_set("rope_lib") {
  sources = [
    "rope.cc",
    "rope.h",
  ]

  deps = [ ":sum_tree_lib" ]
}

executable("bptree_perftest") {
  sources = [ "bptree_perftest.cc" ]

  deps = [ ":bptree_lib" ]
}

# Named apart from //experiments/rope:rope_perftest, which it also builds.
executable("rope_compare") {
  sources = [ "rope_perftest.cc" ]

  deps = [
    ":rope_lib",
    "//experiments/rope:rope_lib",
  ]
}

source_set("btree_unittest") {
  testonly = true

  sources = [ "btree_unittest.cc" ]

  deps = [
    ":btree_lib",
    "//testing:fuzztest",
  ]
}

source_set("bptree_unittest") {
  testonly = true

  sources = [ "bptree_unittest.cc" ]

  deps = [
    ":bptree_lib",
    "//testing:fuzztest",
  ]
}

source_set("sum_tree_unittest") {
  testonly = true

  sources = [ "sum_tree_unittest.cc" ]

  deps = [
    ":sum_tree_lib",
    "//testing:fuzztest",
  ]
}

source_set("rope_unittest") {
  testonly = true

  sources = [ "rope_unittest.cc" ]

  deps = [
    ":rope_lib",
    "//testing:fuzztest",
  ]
}
