group("platform") {
  deps = [ ":platform_demo" ]

  if (is_mac) {
    deps += [
      ":platform_benchmark_suite",
      ":platform_rasterizer",
    ]
  }
}

group("platform_benchmark_suite") {
  deps = [
    ":platform_animation_benchmark",
    ":platform_benchmark",
    ":platform_demo_isolation",
  ]
  if (is_mac) {
    deps += [
      ":move_mouse",
      ":platform_animation_analyzer",
      ":platform_benchmark_analyzer",
      ":scroll_wheel",
    ]
  }
}

executable("platform_demo") {
  sources = [ "demo.cc" ]
  deps = [ ":window" ]
}

executable("platform_benchmark") {
  sources = [ "benchmark/benchmark.cc" ]
  deps = [ ":px" ]
}

executable("platform_animation_benchmark") {
  sources = [ "benchmark/animation_benchmark.cc" ]
  deps = [ ":px" ]
}

executable("platform_demo_isolation") {
  sources = [ "benchmark/demo_isolation.cc" ]
  deps = [ ":window" ]
}

if (is_mac) {
  # Drop-in command-line counterpart to //experiments/rasterizer:rasterizer. Its
  # --test mode keeps that probe's capture geometry and filenames but draws
  # through px/fx/gl_render_context.
  executable("platform_rasterizer") {
    sources = [ "rasterizer.cc" ]
    deps = [
      ":px",
      "//experiments/rasterizer:capture",
    ]
  }

  executable("platform_benchmark_analyzer") {
    sources = [ "benchmark/analyzer.mm" ]

    frameworks = [
      "AVFoundation.framework",
      "CoreMedia.framework",
      "CoreVideo.framework",
      "Foundation.framework",
    ]
  }

  executable("platform_animation_analyzer") {
    sources = [ "benchmark/animation_analyzer.mm" ]

    frameworks = [
      "AVFoundation.framework",
      "CoreMedia.framework",
      "CoreVideo.framework",
      "Foundation.framework",
    ]
  }

  executable("move_mouse") {
    sources = [ "benchmark/move_mouse.cc" ]
    frameworks = [ "ApplicationServices.framework" ]
  }

  executable("scroll_wheel") {
    sources = [ "benchmark/scroll_wheel.cc" ]
    frameworks = [ "ApplicationServices.framework" ]
  }
}

source_set("window") {
  sources = [
    "ui/window.cc",
    "ui/window.h",
  ]
  public_deps = [ ":px" ]
}

if (is_mac) {
  # Renderer-independent font mechanics backed by the CoreText implementation shared with
  # //experiments/rasterizer. This stays separate because fx sits beneath px_font_t and is also
  # consumable by non-window renderers.
  source_set("fx") {
    sources = [
      "fx/fx.cc",
      "fx/fx.h",
      "fx/mac/core_text_font.cc",
    ]

    public_deps = [ "//experiments/rasterizer:font" ]
    deps = [ "//third_party/uni_algo" ]
  }
}

source_set("px") {
  sources = [
    "px/gl_render_context.cc",
    "px/gl_render_context.h",
    "px/px.h",
    "px/px_gl.h",
  ]

  inputs = [
    "px/gl_glyph_frag.glsl",
    "px/gl_glyph_vert.glsl",
    "px/gl_rect_frag.glsl",
    "px/gl_rect_vert.glsl",
  ]

  if (is_mac) {
    sources += [
      "px/mac/px_app.mm",
      "px/mac/px_font.cc",
      "px/mac/px_gl_layer.mm",
      "px/mac/px_keycode.mm",
      "px/mac/px_mac_private.h",
      "px/mac/px_window.mm",
    ]

    frameworks = [
      "AppKit.framework",
      "CoreGraphics.framework",
      "CoreVideo.framework",
      "Foundation.framework",
      "OpenGL.framework",
      "QuartzCore.framework",
    ]
    defines = [ "GL_SILENCE_DEPRECATION" ]
    deps = [ ":fx" ]
  }

  if (is_win) {
    sources += [
      "px/px_font_stub.cc",
      "px/win/px_app.cc",
      "px/win/px_gl.cc",
      "px/win/px_keycode.cc",
      "px/win/px_win_private.h",
      "px/win/px_window.cc",
    ]

    libs = [
      "advapi32.lib",  # RegGetValueW, for the dark-mode preference
      "gdi32.lib",  # pixel formats, regions
      "imm32.lib",  # IME composition
      "opengl32.lib",  # GL 1.1; anything newer goes through wglGetProcAddress
      "shell32.lib",  # DragAcceptFiles, ShellExecuteW
      "user32.lib",
    ]
  }

  if (is_linux) {
    # ST's own binary dlopen/dlsym's GTK rather than linking it (see px_linux_private.h) -- a
    # distribution trick for running against either GTK2 or GTK3, not part of the platform
    # abstraction. This links gtk+-3.0 normally, as instructed.
    sources += [
      "px/linux/px_app.cc",
      "px/linux/px_gl.cc",
      "px/linux/px_keycode.cc",
      "px/linux/px_linux_private.h",
      "px/linux/px_window.cc",
      "px/px_font_stub.cc",
    ]

    public_configs = [ ":gtk3_internal_config" ]

    # GL entry points past 1.1 are ordinary linked symbols on Linux too -- see px_gl.h.
    libs = [ "GL" ]
  }
}

if (is_linux) {
  import("//build/config/linux/pkg_config.gni")

  # GN doesn't check visibility for configs so this gets an obviously internal name to discourage
  # random targets from depending on it directly and bypassing :px's visibility -- the same
  # convention Chromium uses for its own gtk_internal_config.
  pkg_config("gtk3_internal_config") {
    # gtk+-3.0 requires gmodule/gthread but does not always list them as dependencies.
    packages = [
      "gmodule-2.0",
      "gthread-2.0",
      "gtk+-3.0",
    ]
  }
}
