group("platform") {
  deps = [
    ":benchmark",
    ":conformance",
    ":platform_demo",
    ":platform_editor",
  ]
}

# ──────────────────────────────────────────────────────────────────────────────────────────────────
# Demos
# ──────────────────────────────────────────────────────────────────────────────────────────────────
executable("platform_demo") {
  sources = [ "demo.cc" ]
  deps = [ ":window" ]
}

executable("platform_editor") {
  sources = [ "editor.cc" ]
  deps = [ ":window" ]
}

# ──────────────────────────────────────────────────────────────────────────────────────────────────
# Conformance
# ──────────────────────────────────────────────────────────────────────────────────────────────────
group("conformance") {
  deps = [ ":platform_rasterizer" ]

  if (is_mac) {
    deps += [
      ":platform_capture_server",
      ":platform_sidebar",
    ]
  }
}

executable("platform_rasterizer") {
  sources = [ "rasterizer.cc" ]
  deps = [
    ":capture",
    ":px",
    ":scripts",
    ":test_config",
    ":test_corpus",
  ]
}

copy("scripts") {
  sources = [ "conformance/capture/diff.sh" ]
  if (is_mac) {
    sources += [
      "conformance/capture/diff-ui.sh",
      "conformance/capture/mac/capture-ours-ui.sh",
      "conformance/capture/mac/capture-ours.sh",
      "conformance/capture/mac/capture-sublime-ui.sh",
      "conformance/capture/mac/capture-sublime.sh",
    ]
  } else if (is_win) {
    sources += [
      "conformance/capture/win/capture-ours.sh",
      "conformance/capture/win/capture-sublime.sh",
    ]
  }
  outputs = [ "$root_out_dir/{{source_file_part}}" ]
}

copy("test_config") {
  sources = [ "conformance/tests/sizes.txt" ]
  if (is_mac) {
    sources += [ "conformance/tests/faces-mac.txt" ]
  } else if (is_win) {
    sources += [ "conformance/tests/faces-win.txt" ]
  }
  outputs = [ "$root_out_dir/capture-tests/{{source_file_part}}" ]
}

copy("test_corpus") {
  sources = [
    "conformance/tests/texts/emoji.txt",
    "conformance/tests/texts/kerning.txt",
    "conformance/tests/texts/ligatures.txt",
    "conformance/tests/texts/marks.txt",
    "conformance/tests/texts/pangram.txt",
    "conformance/tests/texts/scripts.txt",
  ]
  outputs = [ "$root_out_dir/capture-tests/texts/{{source_file_part}}" ]
}

if (is_mac) {
  copy("ui_test_config") {
    sources = [
      "conformance/tests-ui/faces.txt",
      "conformance/tests-ui/sizes.txt",
    ]
    outputs = [ "$root_out_dir/capture-tests-ui/{{source_file_part}}" ]
  }

  copy("ui_test_corpus") {
    sources = [
      "conformance/tests-ui/texts/arabic.txt",
      "conformance/tests-ui/texts/code.txt",
      "conformance/tests-ui/texts/emoji.txt",
      "conformance/tests-ui/texts/fallback.txt",
      "conformance/tests-ui/texts/kerning.txt",
      "conformance/tests-ui/texts/ligatures.txt",
    ]
    outputs = [ "$root_out_dir/capture-tests-ui/texts/{{source_file_part}}" ]
  }

  executable("platform_sidebar") {
    sources = [ "sidebar.cc" ]
    deps = [
      ":capture",
      ":px",
      ":scripts",
      ":ui_test_config",
      ":ui_test_corpus",
    ]
  }

  executable("platform_capture_server") {
    sources = [ "conformance/capture/mac/capture_server.cc" ]
    deps = [
      ":capture",
      "//third_party/spdlog",
    ]
  }
}

source_set("capture") {
  sources = [ "conformance/capture/capture.h" ]

  if (is_mac) {
    sources += [ "conformance/capture/mac/capture.mm" ]
    framework_dirs = [ "/System/Library/PrivateFrameworks" ]
    frameworks = [
      "AppKit.framework",
      "CoreFoundation.framework",
      "CoreGraphics.framework",
      "ImageIO.framework",
      "SkyLight.framework",
    ]
  } else {
    sources += [ "conformance/capture/win/capture.cc" ]
    deps = [ ":px" ]
    libs = [
      "ole32.lib",
      "opengl32.lib",
      "user32.lib",
      "windowscodecs.lib",
    ]
  }

  configs += [ "//build/config/compiler:prevent_unsafe_narrowing" ]
}

# ──────────────────────────────────────────────────────────────────────────────────────────────────
# Benchmark
# ──────────────────────────────────────────────────────────────────────────────────────────────────
group("benchmark") {
  deps = [
    ":platform_animation_benchmark",
    ":platform_benchmark",
    ":platform_demo_isolation",
  ]
  if (is_mac) {
    deps += [
      ":move_mouse",
      ":platform_animation_analyzer",
      ":platform_benchmark_analyzer",
      ":scroll_wheel",
    ]
  }
}

executable("platform_benchmark") {
  sources = [ "benchmark/benchmark.cc" ]
  deps = [ ":px" ]
}

executable("platform_animation_benchmark") {
  sources = [ "benchmark/animation_benchmark.cc" ]
  deps = [ ":px" ]
}

executable("platform_demo_isolation") {
  sources = [ "benchmark/demo_isolation.cc" ]
  deps = [ ":window" ]
}

if (is_mac) {
  executable("platform_benchmark_analyzer") {
    sources = [ "benchmark/analyzer.mm" ]

    frameworks = [
      "AVFoundation.framework",
      "CoreMedia.framework",
      "CoreVideo.framework",
      "Foundation.framework",
    ]
  }

  executable("platform_animation_analyzer") {
    sources = [ "benchmark/animation_analyzer.mm" ]

    frameworks = [
      "AVFoundation.framework",
      "CoreMedia.framework",
      "CoreVideo.framework",
      "Foundation.framework",
    ]
  }

  executable("move_mouse") {
    sources = [ "benchmark/move_mouse.cc" ]
    frameworks = [ "ApplicationServices.framework" ]
  }

  executable("scroll_wheel") {
    sources = [ "benchmark/scroll_wheel.cc" ]
    frameworks = [ "ApplicationServices.framework" ]
  }
}

source_set("window") {
  sources = [
    "ui/window.cc",
    "ui/window.h",
  ]
  public_deps = [ ":px" ]
}

source_set("fx") {
  sources = [
    "fx/font_private.h",
    "fx/fx.cc",
    "fx/fx.h",
  ]

  if (is_mac) {
    sources += [
      "fx/mac/core_text_backend.cc",
      "fx/mac/core_text_font.cc",
    ]
    frameworks = [
      "CoreFoundation.framework",
      "CoreGraphics.framework",
      "CoreText.framework",
    ]
  } else {
    sources += [
      "fx/win/direct_write_backend.cc",
      "fx/win/direct_write_font.cc",
    ]
    libs = [
      "dwrite.lib",
      "gdi32.lib",
      "user32.lib",
    ]
  }

  configs += [ "//build/config/compiler:prevent_unsafe_narrowing" ]
  public_deps = [ "//base" ]
  deps = [
    "//third_party/spdlog",
    "//third_party/uni_algo",
  ]
}

source_set("px") {
  sources = [
    "px/gl_render_context.cc",
    "px/gl_render_context.h",
    "px/px.h",
    "px/px_gl.h",
  ]

  inputs = [
    "px/gl_glyph_frag.glsl",
    "px/gl_glyph_vert.glsl",
    "px/gl_rect_frag.glsl",
    "px/gl_rect_vert.glsl",
  ]

  sources += [ "px/px_font.cc" ]
  deps = [ ":fx" ]

  if (is_mac) {
    sources += [
      "px/mac/px_app.mm",
      "px/mac/px_gl_layer.mm",
      "px/mac/px_keycode.mm",
      "px/mac/px_mac_private.h",
      "px/mac/px_window.mm",
    ]

    frameworks = [
      "AppKit.framework",
      "CoreGraphics.framework",
      "CoreVideo.framework",
      "Foundation.framework",
      "OpenGL.framework",
      "QuartzCore.framework",
    ]
    defines = [ "GL_SILENCE_DEPRECATION" ]
  }

  if (is_win) {
    sources += [
      "px/win/px_app.cc",
      "px/win/px_gl.cc",
      "px/win/px_keycode.cc",
      "px/win/px_win_private.h",
      "px/win/px_window.cc",
    ]

    libs = [
      "advapi32.lib",  # RegGetValueW, for the dark-mode preference
      "gdi32.lib",  # pixel formats, regions
      "imm32.lib",  # IME composition
      "opengl32.lib",  # GL 1.1; anything newer goes through wglGetProcAddress
      "shell32.lib",  # DragAcceptFiles, ShellExecuteW
      "user32.lib",
    ]
  }

  if (is_linux) {
    # ST's own binary dlopen/dlsym's GTK rather than linking it (see
    # px_linux_private.h) -- a distribution trick for running against either
    # GTK2 or GTK3, not part of the platform abstraction. This links gtk+-3.0
    # normally, as instructed.
    sources += [
      "px/linux/px_app.cc",
      "px/linux/px_gl.cc",
      "px/linux/px_keycode.cc",
      "px/linux/px_linux_private.h",
      "px/linux/px_window.cc",
      "px/px_font_stub.cc",
    ]

    public_configs = [ ":gtk3_internal_config" ]

    # GL entry points past 1.1 are ordinary linked symbols on Linux too -- see
    # px_gl.h.
    libs = [ "GL" ]
  }
}

if (is_linux) {
  import("//build/config/linux/pkg_config.gni")

  # GN doesn't check visibility for configs so this gets an obviously internal
  # name to discourage random targets from depending on it directly and
  # bypassing :px's visibility -- the same convention Chromium uses for its own
  # gtk_internal_config.
  pkg_config("gtk3_internal_config") {
    # gtk+-3.0 requires gmodule/gthread but does not always list them as
    # dependencies.
    packages = [
      "gmodule-2.0",
      "gthread-2.0",
      "gtk+-3.0",
    ]
  }
}
