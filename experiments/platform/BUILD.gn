group("platform") {
  deps = [ ":platform_demo" ]

  if (is_mac) {
    deps += [ ":platform_benchmark_suite" ]
  }
}

group("platform_benchmark_suite") {
  deps = [ ":platform_benchmark" ]
  if (is_mac) {
    deps += [
      ":move_mouse",
      ":platform_benchmark_analyzer",
    ]
  }
}

executable("platform_demo") {
  sources = [ "demo/main.cc" ]
  deps = [ ":window" ]
}

executable("platform_benchmark") {
  sources = [ "benchmark/benchmark.cc" ]
  deps = [ ":px" ]
}

if (is_mac) {
  executable("platform_benchmark_analyzer") {
    sources = [ "benchmark/analyzer.mm" ]

    frameworks = [
      "AVFoundation.framework",
      "CoreMedia.framework",
      "CoreVideo.framework",
      "Foundation.framework",
    ]
  }

  executable("move_mouse") {
    sources = [ "benchmark/move_mouse.cc" ]
    frameworks = [ "ApplicationServices.framework" ]
  }
}

source_set("window") {
  sources = [
    "ui/window.cc",
    "ui/window.h",
  ]
  public_deps = [ ":px" ]
}

source_set("px") {
  sources = [
    "px/gl_render_context.cc",
    "px/gl_render_context.h",
    "px/px.h",
    "px/px_gl.h",
  ]

  if (is_mac) {
    sources += [
      "px/mac/px_app.mm",
      "px/mac/px_gl_layer.mm",
      "px/mac/px_keycode.mm",
      "px/mac/px_mac_private.h",
      "px/mac/px_window.mm",
    ]

    frameworks = [
      "AppKit.framework",
      "CoreGraphics.framework",
      "CoreVideo.framework",
      "Foundation.framework",
      "OpenGL.framework",
      "QuartzCore.framework",
    ]
    defines = [ "GL_SILENCE_DEPRECATION" ]
  }

  if (is_win) {
    sources += [
      "px/win/px_app.cc",
      "px/win/px_gl.cc",
      "px/win/px_keycode.cc",
      "px/win/px_win_private.h",
      "px/win/px_window.cc",
    ]

    libs = [
      "advapi32.lib",  # RegGetValueW, for the dark-mode preference
      "gdi32.lib",  # pixel formats, regions
      "imm32.lib",  # IME composition
      "opengl32.lib",  # GL 1.1; anything newer goes through wglGetProcAddress
      "shell32.lib",  # DragAcceptFiles, ShellExecuteW
      "user32.lib",
    ]
  }

  if (is_linux) {
    # ST's own binary dlopen/dlsym's GTK rather than linking it (see px_linux_private.h) -- a
    # distribution trick for running against either GTK2 or GTK3, not part of the platform
    # abstraction. This links gtk+-3.0 normally, as instructed.
    sources += [
      "px/linux/px_app.cc",
      "px/linux/px_gl.cc",
      "px/linux/px_keycode.cc",
      "px/linux/px_linux_private.h",
      "px/linux/px_window.cc",
    ]

    public_configs = [ ":gtk3_internal_config" ]

    # GL entry points past 1.1 are ordinary linked symbols on Linux too -- see px_gl.h.
    libs = [ "GL" ]
  }
}

if (is_linux) {
  import("//build/config/linux/pkg_config.gni")

  # GN doesn't check visibility for configs so this gets an obviously internal name to discourage
  # random targets from depending on it directly and bypassing :px's visibility -- the same
  # convention Chromium uses for its own gtk_internal_config.
  pkg_config("gtk3_internal_config") {
    # gtk+-3.0 requires gmodule/gthread but does not always list them as dependencies.
    packages = [
      "gmodule-2.0",
      "gthread-2.0",
      "gtk+-3.0",
    ]
  }
}
