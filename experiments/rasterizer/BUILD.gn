executable("rasterizer") {
  sources = [
    "atlas.cc",
    "font_core_text.cc",
    "gl_renderer.mm",
    "main.cc",
  ]

  inputs = [
    "glyph_vert.glsl",
    "glyph_frag.glsl",
  ]

  frameworks = [
    "CoreText.framework",
    "CoreGraphics.framework",
    "CoreFoundation.framework",
    "AppKit.framework",
    "QuartzCore.framework",
    "OpenGL.framework",
  ]
  defines = [ "GL_SILENCE_DEPRECATION" ]

  configs += [ "//build/config/compiler:prevent_unsafe_narrowing" ]

  deps = [
    "//base",
    "//third_party/spdlog",
    "//third_party/uni_algo",
  ]
}
