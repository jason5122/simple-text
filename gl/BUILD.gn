source_set("gl") {
  sources = [
    "gl.cc",
    "gl.h",
    "loader.cc",
    "loader.h",
  ]

  if (is_mac) {
    sources += [ "loader_cgl.cc" ]
  }

  if (is_win) {
    sources += [ "loader_wgl.cc" ]
    libs = [ "opengl32.lib" ]
  }

  if (is_linux) {
    sources += [
      "egl_types.h",
      "loader_egl.cc",
    ]
  }
}
