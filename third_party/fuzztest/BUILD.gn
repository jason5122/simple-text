source_set("init_fuzztest") {
  testonly = true
  sources = [
    "src/fuzztest/init_fuzztest.cc",
    "src/fuzztest/init_fuzztest.h",
  ]
  public_deps = [ ":fuzztest" ]
  deps = [
    "//testing:gtest",
    "//third_party/abseil-cpp:absl_full",
  ]
  configs -= [ "//build/config/compiler:simple_text_code" ]
  configs += [ "//build/config/compiler:no_simple_text_code" ]
}

config("fuzztest_config") {
  include_dirs = [ "src" ]

  defines = [ "CENTIPEDE_DISABLE_RIEGELI" ]
  if (!enable_fuzztest_fuzz) {
    defines += [ "FUZZTEST_NO_LEGACY_COVERAGE" ]
  }

  cflags = [
    "-Wno-sign-compare",
    "-Wno-nullability-completeness",
  ]
}
