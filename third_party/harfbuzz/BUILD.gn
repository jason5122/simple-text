  defines = [
    "HAVE_OT",  # The OpenType shaper -- the core engine.
    "HB_NO_MMAP",  # Don't mmap font files.
    "HB_NO_RESOURCE_FORK",  # No classic-Mac resource-fork font loading.

    # NOTE: we deliberately do NOT define HB_NO_UCD. That leaves HarfBuzz's
    # own bundled Unicode database (hb-ucd.cc / hb-ucd-table.hh) active, so
    # the library is self-contained and needs no ICU.
    #
    # When your lightweight Unicode library is ready and you want to drop the
    # ~1MB UCD table: add "HB_NO_UCD" here, remove hb-ucd.cc + hb-ucd-table.hh
    # from `sources` above, and make sure every buffer gets your funcs via
    # hb_buffer_set_unicode_funcs() -- otherwise the default becomes nil funcs
    # and shaping breaks.

    # Size/scope trims (safe to keep or drop):
    "HB_NO_FALLBACK_SHAPE",  # Only the OT shaper, no dumb fallback.
    "HB_NO_SUBSET",  # Font subsetting (web-font / PDF slimming) -- unused.
    "HB_NO_BUFFER_SERIALIZE",  # Buffer<->text/JSON dump; debug/CLI only.
    "HB_NO_MATH",  # No OpenType MATH table (math typesetting).
    "HB_NO_WIN1256",  # No .fon Arabic win1256 fallback.
    "HB_NO_BUFFER_VERIFY",  # Debug-only buffer verification.
    "HB_NO_DRAW",  # Not using HarfBuzz's outline/draw APIs.
    "HB_NO_BORING_EXPANSION",  # No experimental extensions.
    "HB_NO_VAR_COMPOSITES",  # No VARC yet.
    "HB_NO_PAINT=",  # Empty value works around an upstream build issue.

    # hb.hh uses #pragmas to enable a batch of developer warnings and errors.
    "HB_NO_PRAGMA_GCC_DIAGNOSTIC_WARNING",
    "HB_NO_PRAGMA_GCC_DIAGNOSTIC_ERROR",
  ]

  if (is_linux) {
