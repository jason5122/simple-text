import("src/gn/shared_sources.gni")
import("src/modules/skcms/skcms.gni")

static_library("skia") {
  sources = []
  public = []

  public += skia_core_public
  public += skia_utils_public
  public += skia_effects_public

  sources += skia_core_sources
  sources += skia_ports_sources
  sources += skia_sksl_core_sources
  sources += skia_sksl_core_module_sources
  sources += skia_utils_private
  sources += skia_colorfilters_sources
  sources += skia_effects_sources
  sources += skia_effects_imagefilter_sources

  public += skcms_public_headers
  sources += skcms_public
  sources += skcms_TransformBaseline

  sources += [ "src/src/ports/SkMemory_malloc.cpp" ]
  if (is_win) {
    sources += [
      "src/src/ports/SkLog_win.cpp",
      "src/src/ports/SkOSFile_win.cpp",
    ]
  } else {
    sources += [
      "src/src/ports/SkLog_stdio.cpp",
      "src/src/ports/SkOSFile_posix.cpp",
    ]
  }

  configs -= [ "//build/config/compiler:simple_text_code" ]
  configs += [ "//build/config/compiler:no_simple_text_code" ]

  if (current_cpu == "x64") {
    deps = [
      ":skia_hsw",
      ":skia_skx",
    ]
  }

  public_configs = [ ":skia_config" ]
}

if (current_cpu == "x64") {
  source_set("skia_hsw") {
    sources = skia_opts.hsw_sources + skcms_TransformHsw
    if (is_win) {
      cflags = [ "/arch:AVX2" ]
    } else {
      cflags = [ "-march=x86-64-v3" ]
    }

    configs -= [ "//build/config/compiler:simple_text_code" ]
    configs += [ "//build/config/compiler:no_simple_text_code" ]
    configs += [ ":skia_config" ]
  }

  source_set("skia_skx") {
    sources = skcms_TransformSkx
    if (is_win) {
      cflags = [ "/arch:AVX512" ]
    } else {
      cflags = [
        "-march=x86-64-v4",
        "-mprefer-vector-width=512",
      ]
    }

    configs -= [ "//build/config/compiler:simple_text_code" ]
    configs += [ "//build/config/compiler:no_simple_text_code" ]
    configs += [ ":skia_config" ]
  }
}

config("skia_config") {
  include_dirs = [ "src" ]

  defines = [ "SK_DISABLE_EFFECT_DESERIALIZATION" ]
}
